rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isParent() {
      return isSignedIn() && exists(/databases/$(database)/documents/parents/$(request.auth.uid));
    }

    function getParentFamilyId() {
      return get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.familyId;
    }

    function isFamilyMember(familyId) {
      return isParent() && getParentFamilyId() == familyId;
    }

    function isChildInFamily(childId) {
      let familyId = getParentFamilyId();
      return isParent() && childId in get(/databases/$(database)/documents/families/$(familyId)).data.childDeviceIds;
    }

    // --- Rules ---

    // Parents collection: Only the parent can read/write their own profile
    match /parents/{uid} {
      allow read, write: if request.auth.uid == uid;

      match /notificationSettings/{doc} {
        allow read, write: if request.auth.uid == uid;
      }

      match /notifications/{notifId} {
        allow read, write: if request.auth.uid == uid;
      }

      match /devices/{deviceId} {
        allow read, write: if request.auth.uid == uid;
      }
    }

    // Families collection: Parents can read their family data.
    // Write access should generally be restricted to Cloud Functions for safety,
    // but we allow update for pairing if we don't have functions yet.
    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isSignedIn();
      allow update: if isFamilyMember(familyId);

      match /safeZones/{zoneId} {
        allow read, write: if isFamilyMember(familyId);
      }
    }

    // Children collection: Parents can read their children's data.
    match /children/{childId} {
      allow read: if isChildInFamily(childId);
      allow write: if isSignedIn(); // Allow child app (anonymous auth) to create its record

      match /status/current {
        allow read: if isChildInFamily(childId);
        allow write: if isSignedIn(); // Child app updates status
      }

      match /locations/{docId} {
        allow read: if isChildInFamily(childId);
        allow create: if isSignedIn(); // Child app uploads location
      }

      match /activities/{docId} {
        allow read: if isChildInFamily(childId);
        allow create: if isSignedIn(); // Child app uploads activity
      }

      match /sosEvents/{docId} {
        allow read: if isChildInFamily(childId);
        allow create: if isSignedIn(); // Child app triggers SOS
        allow update: if isChildInFamily(childId); // Parent resolves SOS
      }

      match /safeZones/{zoneId} {
        allow read: if isChildInFamily(childId);
        allow write: if isChildInFamily(childId); // Parent manages zones
      }

      match /dailySummaries/{docId} {
        allow read: if isChildInFamily(childId);
      }

      match /remoteCommands/{docId} {
        allow read: if isSignedIn(); // Child app listens for commands
        allow create: if isChildInFamily(childId); // Parent sends command
        allow update: if isSignedIn(); // Child app marks as executed
      }
    }

    // Pairing Codes: Short-lived, used for linking
    match /pairingCodes/{code} {
      allow read, write: if isSignedIn();
    }

    // App Config: Read-only for everyone
    match /appConfig/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
