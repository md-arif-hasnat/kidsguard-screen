rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isParent() {
      return isSignedIn() && exists(/databases/$(database)/documents/parents/$(request.auth.uid));
    }

    function getParentFamilyId() {
      return get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.familyId;
    }

    function isFamilyMember(familyId) {
      return isParent() && getParentFamilyId() == familyId;
    }

    function getFamilyData(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }

    function getUserMember(familyId) {
      return getFamilyData(familyId).members.filter(m => m.uid == request.auth.uid)[0];
    }

    function getUserRole(familyId) {
      return getUserMember(familyId).role;
    }

    function isOwner(familyId) {
      return getUserRole(familyId) == 'OWNER';
    }

    function isParentOrAbove(familyId) {
      let role = getUserRole(familyId);
      return role == 'OWNER' || role == 'PARENT';
    }

    function isGuardianOrAbove(familyId) {
      let role = getUserRole(familyId);
      return role == 'OWNER' || role == 'PARENT' || role == 'GUARDIAN';
    }

    function isChildInFamily(childId) {
      let familyId = getParentFamilyId();
      return isParent() && childId in getFamilyData(familyId).childDeviceIds;
    }

    // --- Rules ---

    match /parents/{uid} {
      allow read, write: if request.auth.uid == uid;

      match /notificationSettings/{doc} {
        allow read, write: if request.auth.uid == uid;
      }
      match /notifications/{notifId} {
        allow read, write: if request.auth.uid == uid;
      }
      match /devices/{deviceId} {
        allow read, write: if request.auth.uid == uid;
      }
    }

    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isSignedIn();
      allow update: if isOwner(familyId);

      match /safeZones/{zoneId} {
        allow read: if isGuardianOrAbove(familyId);
        allow write: if isParentOrAbove(familyId);
      }
      match /emergencyContacts/{contactId} {
        allow read: if isGuardianOrAbove(familyId);
        allow write: if isParentOrAbove(familyId);
      }
    }

    match /children/{childId} {
      // Top level child doc
      allow read: if isChildInFamily(childId);
      allow write: if isSignedIn(); // Child app initialization

      // Child Status
      match /status/current {
        allow read: if isChildInFamily(childId);
        allow write: if isSignedIn(); // Child app updates status
      }

      // Safe Zones (Scoped by child)
      match /safeZones/{zoneId} {
        allow read: if isChildInFamily(childId) && isGuardianOrAbove(getParentFamilyId());
        allow write: if isChildInFamily(childId) && isParentOrAbove(getParentFamilyId());
      }

      // Location Tracking
      match /locations/{docId} {
        allow read: if isChildInFamily(childId) && isGuardianOrAbove(getParentFamilyId());
        allow create: if isSignedIn(); // Child app uploads location
      }

      // Activity Feed
      match /activities/{docId} {
        allow read: if isChildInFamily(childId) && isGuardianOrAbove(getParentFamilyId());
        allow create: if isSignedIn(); // Child app uploads activity
      }

      // SOS Events
      match /sosEvents/{docId} {
        allow read: if isChildInFamily(childId) && isGuardianOrAbove(getParentFamilyId());
        allow create: if isSignedIn(); // Child app triggers SOS
        allow update: if isChildInFamily(childId) && isParentOrAbove(getParentFamilyId());
      }

      // Remote Commands
      match /remoteCommands/{docId} {
        allow read: if isSignedIn(); // Child app listens
        allow create: if isChildInFamily(childId) && isParentOrAbove(getParentFamilyId());
        allow update: if isSignedIn(); // Child app marks as EXECUTED
      }

      // Web Protection
      match /webRules/current {
        allow read: if isChildInFamily(childId) && isGuardianOrAbove(getParentFamilyId());
        allow write: if isChildInFamily(childId) && isParentOrAbove(getParentFamilyId());
      }
      match /webActivity/{date}/events/{docId} {
        allow read: if isChildInFamily(childId) && isGuardianOrAbove(getParentFamilyId());
        allow create: if isSignedIn(); // Child app reports activity
      }
      match /accessRequests/{requestId} {
        allow read: if isChildInFamily(childId) && isGuardianOrAbove(getParentFamilyId());
        allow create: if isSignedIn(); // Child app requests access
        allow update: if isChildInFamily(childId) && isParentOrAbove(getParentFamilyId());
      }

      // Intelligence & Analytics
      match /dailySummaries/{docId} {
        allow read: if isChildInFamily(childId) && isGuardianOrAbove(getParentFamilyId());
      }
      match /routeSummaries/{docId} {
        allow read: if isChildInFamily(childId) && isGuardianOrAbove(getParentFamilyId());
      }
      match /analytics/{date} {
        allow read: if isChildInFamily(childId) && isGuardianOrAbove(getParentFamilyId());
      }
      match /routeDeviations/{docId} {
        allow read: if isChildInFamily(childId) && isGuardianOrAbove(getParentFamilyId());
      }

      // Digital Wellbeing
      match /appUsage/{date} {
        allow read: if isChildInFamily(childId) && isGuardianOrAbove(getParentFamilyId());
        allow write: if isSignedIn(); // Child app reports usage
      }

      // Protection Modes
      match /protectionModes/{modeId} {
        allow read: if isChildInFamily(childId) && isGuardianOrAbove(getParentFamilyId());
        allow write: if isChildInFamily(childId) && isParentOrAbove(getParentFamilyId());
      }
    }

    match /familyInvitations/{inviteId} {
      allow read: if isSignedIn();
      allow create: if isParentOrAbove(request.resource.data.familyId);
      allow update: if isSignedIn() && (request.resource.data.status == 'ACCEPTED' || isParentOrAbove(get(/databases/$(database)/documents/familyInvitations/$(inviteId)).data.familyId));
    }

    match /auditLogs/{logId} {
      allow read: if isGuardianOrAbove(resource.data.familyId);
      allow create: if isSignedIn();
    }

    match /pairingCodes/{code} {
      allow read, write: if isSignedIn();
    }

    // --- Platform Admin Portal ---

    function isPlatformAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.active == true;
    }

    function getPlatformAdminRole() {
      return get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.role;
    }

    function isInternalPowerUser() {
      let role = getPlatformAdminRole();
      return role == 'SUPER_ADMIN' || role == 'ADMIN' || role == 'DEVELOPER';
    }

    match /platformAdmins/{uid} {
      allow read: if isSignedIn();
    }

    match /supportTickets/{ticketId} {
      allow read: if isPlatformAdmin() || (isParent() && resource.data.parentUid == request.auth.uid);
      allow create: if isParent();
      allow update: if isPlatformAdmin() || (isParent() && resource.data.parentUid == request.auth.uid);
    }

    match /appConfig/{doc} {
      allow read: if true;
      allow write: if isPlatformAdmin() && isInternalPowerUser();
    }

    match /appReleases/{doc} {
      allow read: if true;
      allow write: if isPlatformAdmin() && isInternalPowerUser();
    }
  }
}
