rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the user is the owner of this device record
    function isDeviceOwner(deviceId) {
      return isSignedIn() && request.auth.uid == deviceId;
    }

    // Check if user is the parent in the family
    function isParentOfFamily(familyId) {
      return isSignedIn() && get(/databases/$(database)/documents/families/$(familyId)).data.parentDeviceId == request.auth.uid;
    }

    // Check if user is a child in the family
    function isChildOfFamily(familyId) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.childDeviceIds;
    }

    // Check if user belongs to the family (either parent or child)
    function isFamilyMember(familyId) {
      return isParentOfFamily(familyId) || isChildOfFamily(familyId);
    }

    // To check parent-child relationship without familyId in path
    // This assumes child documents contain a familyId or we have a mapping
    function isParentOfChild(childId) {
        let familyId = get(/databases/$(database)/documents/children/$(childId)/status/current).data.familyId;
        return isParentOfFamily(familyId);
    }

    // --- COLLECTION RULES ---

    // Devices: Mapping Firebase UID to device metadata
    match /devices/{deviceId} {
      allow read: if isSignedIn();
      allow write: if isDeviceOwner(deviceId);
    }

    // Parents: Profile data
    match /parents/{parentId} {
      allow read, write: if isSignedIn() && request.auth.uid == parentId;
    }

    // Families: Root of the relational structure
    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isSignedIn(); // Allow creation during initial setup
      allow update: if isParentOfFamily(familyId);
      allow delete: if false; // Prevention of accidental deletion
    }

    // Children: Status and settings
    match /children/{childId} {
      allow read: if isSignedIn(); // Basic read for pairing/lookup

      match /status/current {
        allow read: if isSignedIn();
        allow write: if request.auth.uid == childId;
      }

      match /locations/{locationId} {
        allow read: if isSignedIn(); // Parent reads history
        allow create: if request.auth.uid == childId;
        allow update, delete: if false; // Locations are immutable history
      }

      match /activity/{activityId} {
        allow read: if isSignedIn();
        allow create: if request.auth.uid == childId;
        allow update, delete: if false;
      }

      match /remoteCommands/{commandId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn(); // Parent creates command
        allow update: if request.auth.uid == childId; // Child updates status (PENDING -> EXECUTED)
      }
    }

    // Safe Zones
    match /safeZones/{familyId}/{zoneId} {
      allow read, write: if isFamilyMember(familyId);
    }

    // SOS Events
    match /sosEvents/{childId}/{eventId} {
      allow read: if isSignedIn();
      allow create: if request.auth.uid == childId;
      allow update: if isSignedIn(); // Both can update (resolve)
    }

    // Daily Summaries
    match /dailySummaries/{childId}/{date} {
      allow read: if isSignedIn();
      allow write: if false; // Generated by System/Cloud Functions ONLY
    }

    // Route Deviations
    match /routeDeviations/{childId}/{deviationId} {
      allow read: if isSignedIn();
      allow create: if request.auth.uid == childId; // Child app detects locally and syncs
      allow update: if isSignedIn(); // Parent marks as seen/resolved
    }

    // Pairing Codes: Temporary short-lived tokens
    match /pairingCodes/{code} {
      allow read: if isSignedIn(); // Parent reads to validate
      allow create: if isSignedIn(); // Child creates
      allow delete: if isSignedIn(); // Parent deletes after successful use

      // Validation: Ensure pairing codes expire (checked by app, but rules can enforce)
      // allow create: if request.resource.data.expiresAt > request.time;
    }

    // Notifications: Push history
    match /notifications/{userId}/{notificationId} {
        allow read: if request.auth.uid == userId;
        allow write: if false; // System only
    }

    // --- DENY ALL DEFAULT ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
