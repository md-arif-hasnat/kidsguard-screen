# Paddle Billing public browser configuration
# Use sandbox values until Paddle approves the account and product.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Legacy monthly variable remains supported, but the explicit name is preferred.
NEXT_PUBLIC_PADDLE_PRICE_ID=
NEXT_PUBLIC_PADDLE_MONTHLY_PRICE_ID=
NEXT_PUBLIC_PADDLE_YEARLY_PRICE_ID=
# Legacy monthly add-on variable remains supported.
NEXT_PUBLIC_PADDLE_EXTRA_CHILD_PRICE_ID=
NEXT_PUBLIC_PADDLE_EXTRA_CHILD_MONTHLY_PRICE_ID=
NEXT_PUBLIC_PADDLE_EXTRA_CHILD_YEARLY_PRICE_ID=
