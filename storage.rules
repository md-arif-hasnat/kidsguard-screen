rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isVerified() {
      return request.auth != null &&
        request.auth.token.email_verified == true;
    }

    function ownsTicket(ticketId) {
      let ticketPath =
        /databases/(default)/documents/supportTickets/$(ticketId)
      ;
      return firestore.exists(ticketPath) &&
        firestore.get(ticketPath).data.parentUid == request.auth.uid;
    }

    function hasActivePlatformRole(roles) {
      let adminPath =
        /databases/(default)/documents/platformAdmins/$(request.auth.uid)
      ;
      let sessionPath =
        /databases/(default)/documents/internalAdminSessions/$(request.auth.uid)
      ;

      return isVerified() &&
        request.auth.token.auth_time is int &&
        firestore.exists(adminPath) &&
        firestore.exists(sessionPath) &&
        firestore.get(sessionPath).data.state == 'ACTIVE' &&
        firestore.get(sessionPath).data.authTime == request.auth.token.auth_time &&
        firestore.get(sessionPath).data.expiresAt is timestamp &&
        request.time < firestore.get(sessionPath).data.expiresAt &&
        firestore.get(adminPath).data.active == true &&
        firestore.get(adminPath).data.role in roles;
    }

    function isPlatformAdmin() {
      return hasActivePlatformRole([
          'SUPER_ADMIN',
          'PLATFORM_ADMIN',
          'DEV_ADMIN'
        ]) &&
        request.auth.token.firebase is map &&
        request.auth.token.firebase.keys().hasAll(['sign_in_second_factor']) &&
        request.auth.token.firebase.sign_in_second_factor == 'totp';
    }

    function isSupportStaff() {
      return isPlatformAdmin() ||
        hasActivePlatformRole(['EMPLOYEE']);
    }

    match /supportTickets/{parentUid}/{ticketId}/{fileName} {
      allow read: if isVerified() &&
        (
          (
            request.auth.uid == parentUid &&
            ownsTicket(ticketId)
          ) ||
          isSupportStaff()
        );

      allow create: if isVerified() &&
        request.auth.uid == parentUid &&
        ownsTicket(ticketId) &&
        request.resource.size > 0 &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches(
          '^(image/(jpeg|png|webp)|application/pdf)$'
        );

      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
