{
  "name": "kidsguard-functions",
  "scripts": {
    "build": "tsc",
    "test:login-defense": "npm run build && node --test tests/internal-login-defense.test.cjs",
    "test:session-defense": "npm run build && node --test tests/internal-session-defense.test.cjs",
    "test:security": "npm run build && node --test tests/internal-login-defense.test.cjs tests/internal-session-defense.test.cjs",
    "lint": "echo Skipping lint",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "archiver": "^8.0.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/minimatch": "5.1.2",
    "@types/node": "^22.0.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@types/minimatch": "5.1.2"
  },
  "private": true
}
