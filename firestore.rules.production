rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
        function isEmailVerified() {
          return isSignedIn() &&
            request.auth.token.email_verified == true;
        }

            function isAdmin() {
              return isEmailVerified() &&
                get(
                  /databases/$(database)/documents/parents/$(request.auth.uid)
                ).data.role == 'ADMIN';
            }

            function hasActivePlatformRole(roles) {
              let adminPath =
                /databases/$(database)/documents/platformAdmins/$(request.auth.uid);

              return isEmailVerified() &&
                request.auth.token.auth_time is int &&
                request.time.toMillis() <
                  request.auth.token.auth_time * 1000 + 8 * 60 * 60 * 1000 &&
                exists(adminPath) &&
                get(adminPath).data.active == true &&
                get(adminPath).data.role in roles;
            }

            function hasTotpPlatformRole(roles) {
              return hasActivePlatformRole(roles) &&
                request.auth.token.firebase is map &&
                request.auth.token.firebase.keys()
                  .hasAll(['sign_in_second_factor']) &&
                request.auth.token.firebase.sign_in_second_factor == 'totp';
            }

            function isPlatformAdmin() {
              return hasTotpPlatformRole([
                'SUPER_ADMIN',
                'PLATFORM_ADMIN',
                'DEV_ADMIN'
              ]);
            }

            function isSupportStaff() {
              return isPlatformAdmin() ||
                hasActivePlatformRole(['EMPLOYEE']);
            }

            function isEmployeeStaff() {
              return hasActivePlatformRole(['EMPLOYEE']);
            }

            function isAccountingStaff() {
              return isPlatformAdmin() ||
                hasActivePlatformRole(['ACCOUNTING']);
            }


        function familyData(familyId) {
          return get(
            /databases/$(database)/documents/families/$(familyId)
          ).data;
        }

        function isFamilyOwner(familyId) {
          return isEmailVerified() &&
            familyData(familyId).ownerId == request.auth.uid;
        }

        function hasValidRetentionPolicy() {
          return request.resource.data.settings is map &&
            (
              !request.resource.data.settings.keys()
                .hasAny(['dataRetentionDays']) ||
              request.resource.data.settings.dataRetentionDays in [
                0,
                30,
                90,
                365
              ]
            );
        }
            function isDeviceOwner(deviceId) {
              return isSignedIn() &&
                get(
                  /databases/$(database)/documents/devices/$(deviceId)
                ).data.firebaseUid == request.auth.uid;
            }

            function isChildIdentity(childId) {
              return isSignedIn() &&
                get(
                  /databases/$(database)/documents/children/$(childId)
                ).data.firebaseUid == request.auth.uid;
            }

            function canReadChild(childId) {
              let child = get(
                /databases/$(database)/documents/children/$(childId)
              ).data;

              return isSignedIn() &&
                (
                  child.firebaseUid == request.auth.uid ||
                  isFamilyMember(child.familyId)
                );
            }
                function isParentForChild(childId) {
                  let child = get(
                    /databases/$(database)/documents/children/$(childId)
                  ).data;

                        return isEmailVerified() &&
                          isFamilyManager(child.familyId);
                }

        function isFamilyMember(familyId) {
          let family = familyData(familyId);

          return isEmailVerified() &&
            (
              family.ownerId == request.auth.uid ||
              (
                family.keys().hasAny(['memberUids']) &&
                family.memberUids is list &&
                request.auth.uid in family.memberUids
              )
            );
        }
            function isFamilyManager(familyId) {
              let family = familyData(familyId);

              return isEmailVerified() &&
                (
                  family.ownerId == request.auth.uid ||
                  (
                    family.keys().hasAny(['managerUids']) &&
                    family.managerUids is list &&
                    request.auth.uid in family.managerUids
                  )
                );
            }

            match /adminNotifications/{notificationId} {
              allow read: if isPlatformAdmin();
              allow create, update, delete: if false;
            }

            match /issueTriage/{fingerprint} {
              allow read: if isSupportStaff();

              allow create, update: if isSupportStaff() &&
                fingerprint.size() > 0 &&
                fingerprint.size() <= 128 &&
                request.resource.data.fingerprint == fingerprint &&
                request.resource.data.status in [
                  'OPEN',
                  'ACKNOWLEDGED',
                  'RESOLVED'
                ] &&
                request.resource.data.updatedBy == request.auth.uid &&
                request.resource.data.updatedAt == request.time &&
                request.resource.data.keys().hasOnly([
                  'fingerprint',
                  'status',
                  'updatedBy',
                  'updatedAt'
                ]);

              allow delete: if false;
            }

            match /platformAdmins/{adminId} {
              allow get: if isEmailVerified() &&
                request.auth.uid == adminId;

              allow list: if isPlatformAdmin();
              allow create, update, delete: if false;
            }

            match /platformStaffApprovalRequests/{requestId} {
              allow read: if isPlatformAdmin();
              allow create, update, delete: if false;
            }

            match /platformStaffApprovalSecrets/{requestId} {
              allow read, write: if false;
            }

            match /platformStaffRateLimits/{adminId} {
              allow read, write: if false;
            }
    match /parents/{parentId} {
      allow read: if isAccountingStaff() ||
        (isEmailVerified() && request.auth.uid == parentId);

            allow create: if isSignedIn() &&
              request.auth.uid == parentId &&
              request.resource.data.uid == request.auth.uid &&
              (
                isEmailVerified() ||
                request.resource.data.keys().hasAll([
                  'legalConsentAcceptedAt',
                  'termsVersion',
                  'privacyVersion',
                  'adultConfirmedAt'
                ])
              ) &&
              (
                !request.resource.data.keys().hasAny(['role']) ||
                request.resource.data.role in [
                  'OWNER',
                  'MANAGER',
                  'PARENT',
                  'GUARDIAN',
                  'VIEWER'
                ]
              );

            allow update: if isEmailVerified() &&
              request.auth.uid == parentId &&
              !request.resource.data
                .diff(resource.data)
                .affectedKeys()
                .hasAny([
                  'uid',
                  'role',
                  'subscriptionStatus',
                  'trialStartedAt',
                  'trialEndsAt',
                  'planId',
                  'basePriceCents',
                  'includedChildren',
                  'extraChildPriceCents',
                  'currency'
                ]);

            allow delete: if isEmailVerified() &&
              request.auth.uid == parentId;

      match /{subcollection}/{documentId}/{nested=**} {
        allow read, write: if isEmailVerified() &&
          request.auth.uid == parentId;
      }
    }

    match /billingConfig/{configId} {
      allow read: if isEmailVerified();

      // Billing configuration is managed only by verified platform admins.
      allow create, update, delete: if isPlatformAdmin();
    }

    match /promoCodes/{code} {
      // Coupon details and redemption controls are exposed to customers only
      // through authenticated Cloud Functions. Admins may list them for the
      // internal management page, but all writes remain server-authoritative.
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    match /promoRedemptions/{redemptionId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    match /promoEmailHistory/{messageId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    match /paddleWebhookEvents/{eventId} {
      // Webhook receipts are written only through the Admin SDK after
      // Paddle signature verification. Clients can never forge or alter them.
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    match /subscriptionCancellationRequests/{requestId} {
      // Requests are created and changed only by trusted Cloud Functions.
      allow read: if isAccountingStaff() ||
        (
          isEmailVerified() &&
          resource.data.familyId is string &&
          isFamilyOwner(resource.data.familyId)
        );
      allow create, update, delete: if false;
    }

        match /families/{familyId} {
          allow read: if isAccountingStaff() || isFamilyMember(familyId);

          allow create: if isEmailVerified() &&
            request.resource.data.ownerId == request.auth.uid &&
            request.resource.data.memberUids == [request.auth.uid] &&
            request.resource.data.managerUids == [request.auth.uid] &&
            request.resource.data.childDeviceIds is list &&
            request.resource.data.childDeviceIds.size() == 0 &&
            request.resource.data.subscription.baseChildSlots == 2 &&
            request.resource.data.subscription.extraChildSlots == 0 &&
            request.resource.data.subscription.status == 'PENDING';

                allow update: if isFamilyOwner(familyId) &&
                  hasValidRetentionPolicy() &&
                  request.resource.data.ownerId ==
                    resource.data.ownerId &&
                  !request.resource.data
                    .diff(resource.data)
                    .affectedKeys()
                    .hasAny([
                      'ownerId',
                      'childDeviceIds',
                      'subscription',
                      'deletionStatus',
                      'deletionRequestedAt',
                      'deletionScheduledAt',
                      'deletionRequestedBy'
                    ]);
          allow delete: if false;
                match /safeZones/{zoneId} {
                  allow read: if isFamilyMember(familyId);
                  allow write: if isFamilyOwner(familyId);
                }

                match /weeklyReports/{reportId} {
                  allow read: if isFamilyMember(familyId);
                  allow create, update, delete: if false;
                }

                match /children/{childId}/youtubeHistory/{historyId} {
                  allow read: if canReadChild(childId) &&
                    get(
                      /databases/$(database)/documents/children/$(childId)
                    ).data.familyId == familyId;

                  allow create, update: if isChildIdentity(childId) &&
                    get(
                      /databases/$(database)/documents/children/$(childId)
                    ).data.familyId == familyId;

                  allow delete: if false;
                }

                match /children/{childId}/browserHistory/{historyId} {
                  allow read: if canReadChild(childId) &&
                    get(
                      /databases/$(database)/documents/children/$(childId)
                    ).data.familyId == familyId;

                  allow create, update: if isChildIdentity(childId) &&
                    get(
                      /databases/$(database)/documents/children/$(childId)
                    ).data.familyId == familyId;

                  allow delete: if false;
                }
        }
            match /devices/{deviceId} {
              allow create: if isSignedIn() &&
                request.resource.data.firebaseUid == request.auth.uid &&
                request.resource.data.deviceId == deviceId;

                    allow read, delete: if isDeviceOwner(deviceId);

                    allow update: if isDeviceOwner(deviceId) &&
                      request.resource.data.firebaseUid ==
                        resource.data.firebaseUid &&
                      request.resource.data.deviceId ==
                        resource.data.deviceId;
            }

            match /pairingCodes/{code} {
              allow create: if isSignedIn() &&
                code.matches('^[0-9]{6}$') &&
                request.resource.data.code == code &&
                request.resource.data.firebaseUid == request.auth.uid &&
                request.resource.data.childId is string &&
                request.resource.data.deviceId is string &&
                isDeviceOwner(request.resource.data.deviceId) &&
                request.resource.data.used == false &&
                request.resource.data.expiresAt > request.time;

              allow read, delete: if isSignedIn() &&
                resource.data.firebaseUid == request.auth.uid;

              // Only Admin Cloud Functions can update/consume a code.
              allow update: if false;
            }

                match /children/{childId} {
                  allow read: if isSupportStaff() || canReadChild(childId);

                  // Root child records are managed by Admin Cloud Functions.
                  allow create, update, delete: if false;

                  match /status/{statusId} {
                    allow read: if isSupportStaff() || canReadChild(childId);

                            allow create: if isChildIdentity(childId) &&
                              request.resource.data.childId == childId &&
                              request.resource.data.deviceId is string &&
                              isDeviceOwner(request.resource.data.deviceId);

                            allow update: if isChildIdentity(childId) &&
                              resource.data.childId == childId &&
                              request.resource.data.childId ==
                                resource.data.childId &&
                              request.resource.data.deviceId ==
                                resource.data.deviceId &&
                              isDeviceOwner(resource.data.deviceId);

                    allow delete: if false;
                  }
                        match /safeZones/{zoneId} {
                          allow read: if canReadChild(childId);
                          allow write: if isParentForChild(childId);
                        }

                        match /locations/{locationId} {
                          allow read: if canReadChild(childId);

                          allow create: if isChildIdentity(childId);

                          allow update: if locationId == 'latest' &&
                            isChildIdentity(childId);

                          allow delete: if false;
                        }

                        match /activities/{activityId} {
                          allow read: if canReadChild(childId);

                          allow create: if isChildIdentity(childId);

                          allow update, delete: if false;

                        }

                        match /tamperEvents/{eventId} {
                          allow read: if canReadChild(childId);

                          allow create: if isChildIdentity(childId) &&
                            request.resource.data.type == 'TAMPER_ALERT' &&
                            request.resource.data.childId == childId &&
                            request.resource.data.familyId ==
                              get(
                                /databases/$(database)/documents/children/$(childId)
                              ).data.familyId &&
                            request.resource.data.reason in [
                              'DEVICE_ADMIN_DISABLED',
                              'ACCESSIBILITY_DISABLED',
                              'KIDSGUARD_UNINSTALL_ATTEMPT',
                              'KIDSGUARD_SETTINGS_TAMPER_ATTEMPT'
                            ] &&
                            request.resource.data.title is string &&
                            request.resource.data.title.size() <= 120 &&
                            request.resource.data.body is string &&
                            request.resource.data.body.size() <= 300;

                          allow update, delete: if false;
                        }

                        match /errorReports/{errorId} {
                          allow read: if isSupportStaff();

                          allow create: if isChildIdentity(childId) &&
                            request.resource.data.errorId == errorId &&
                            request.resource.data.childId == childId &&
                            request.resource.data.familyId ==
                              get(
                                /databases/$(database)/documents/children/$(childId)
                              ).data.familyId &&
                            request.resource.data.status == 'OPEN' &&
                            request.resource.data.tag is string &&
                            request.resource.data.tag.size() <= 80 &&
                            request.resource.data.message is string &&
                            request.resource.data.message.size() <= 300 &&
                            request.resource.data.capturedAt is number &&
                            request.resource.data.fingerprint is string;

                          allow update, delete: if false;
                        }
                              match /sosEvents/{eventId} {
                                allow read: if canReadChild(childId);

                                allow create: if isChildIdentity(childId);

                                allow update: if isChildIdentity(childId) ||
                                  isParentForChild(childId);

                                allow delete: if false;
                              }
                                    match /dailySummaries/{summaryId} {
                                      allow read: if canReadChild(childId);

                                      // Generated only by trusted Admin Cloud Functions.
                                      allow write: if false;
                                    }

                                    match /routeDeviations/{deviationId} {
                                      allow read: if canReadChild(childId);

                                      allow create: if isChildIdentity(childId);

                                      allow update: if isChildIdentity(childId) ||
                                        isParentForChild(childId);

                                      allow delete: if false;
                                    }
                              match /remoteCommands/{commandId} {
                                allow read: if canReadChild(childId);

                                allow create, delete: if isParentForChild(childId);

                                allow update: if isParentForChild(childId) ||
                                  (
                                    isChildIdentity(childId) &&
                                    request.resource.data
                                      .diff(resource.data)
                                      .affectedKeys()
                                      .hasOnly([
                                        'status',
                                        'receivedAt',
                                        'executedAt',
                                        'resultMessage'
                                      ]) &&
                                    (
                                      (
                                        resource.data.status == 'PENDING' &&
                                        request.resource.data.status in [
                                          'DELIVERED',
                                          'EXPIRED',
                                          'FAILED'
                                        ]
                                      ) ||
                                      (
                                        resource.data.status == 'DELIVERED' &&
                                        request.resource.data.status in [
                                          'APPLIED',
                                          'EXPIRED',
                                          'FAILED'
                                        ]
                                      )
                                    )
                                  );
                              }
                                    match /installedApps/{appId} {
                                      allow read: if canReadChild(childId);
                                      allow write: if isChildIdentity(childId);
                                    }

                                    match /appUsage/{document=**} {
                                      allow read: if canReadChild(childId);
                                      allow write: if isChildIdentity(childId);
                                    }

                                    match /youtubeHistory/{historyId} {
                                      allow read: if canReadChild(childId);
                                      allow write: if isChildIdentity(childId);
                                    }

                                    match /webActivity/{document=**} {
                                      allow read: if canReadChild(childId);
                                      allow write: if isChildIdentity(childId);
                                    }
                                          match /appControls/{controlId} {
                                            allow read: if canReadChild(childId);
                                            allow create, delete: if isParentForChild(childId);
                                            allow update: if isParentForChild(childId) ||
                                              (isChildIdentity(childId) &&
                                                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                                                  'applyStatus',
                                                  'appliedAt',
                                                  'appliedByDeviceId',
                                                  'appliedVersion',
                                                  'applyMessage'
                                                ]));
                                          }

                                          match /appRestrictionEvents/{eventId} {
                                            allow read: if canReadChild(childId);
                                            allow create: if isChildIdentity(childId);
                                            allow update, delete: if false;
                                          }

                                          match /settings/{settingId} {
                                            allow read: if canReadChild(childId);
                                            allow write: if isParentForChild(childId);
                                          }

                                          match /permissionChangeRequests/{requestId} {
                                            allow read: if canReadChild(childId);

                                            allow create: if isChildIdentity(childId) &&
                                              request.resource.data.requestId == requestId &&
                                              request.resource.data.childId == childId &&
                                              request.resource.data.familyId ==
                                                get(
                                                  /databases/$(database)/documents/children/$(childId)
                                                ).data.familyId &&
                                              request.resource.data.permissionType is string &&
                                              request.resource.data.permissionName is string &&
                                              request.resource.data.status == 'PENDING';

                                            allow update: if isParentForChild(childId) &&
                                              resource.data.status == 'PENDING' &&
                                              request.resource.data.requestId ==
                                                resource.data.requestId &&
                                              request.resource.data.childId ==
                                                resource.data.childId &&
                                              request.resource.data.familyId ==
                                                resource.data.familyId &&
                                              request.resource.data.permissionType ==
                                                resource.data.permissionType &&
                                              request.resource.data.status in [
                                                'APPROVED',
                                                'DENIED'
                                              ] &&
                                              request.resource.data
                                                .diff(resource.data)
                                                .affectedKeys()
                                                .hasOnly([
                                                  'status',
                                                  'reviewedAt',
                                                  'reviewedBy',
                                                  'expiresAt'
                                                ]);

                                            allow delete: if false;
                                          }

                                          match /webRules/{ruleId} {
                                            allow read: if canReadChild(childId);
                                            allow write: if isParentForChild(childId);
                                          }

                                          match /protectionModes/{modeId} {
                                            allow read: if canReadChild(childId);

                                            // The child consumes these rules but must never be
                                            // able to weaken or delete a parent policy.
                                            allow create, update, delete:
                                              if isParentForChild(childId);
                                          }

                                          match /accessRequests/{requestId} {
                                            allow read: if canReadChild(childId);

                                            allow create: if isChildIdentity(childId) &&
                                              request.resource.data.requestId == requestId &&
                                              request.resource.data.childId == childId &&
                                              request.resource.data.domain is string &&
                                              request.resource.data.domain.size() > 0 &&
                                              request.resource.data.domain.size() <= 253 &&
                                              request.resource.data.status == 'PENDING';

                                            allow update: if isParentForChild(childId) &&
                                              resource.data.status == 'PENDING' &&
                                              request.resource.data.status in [
                                                'APPROVED',
                                                'DENIED'
                                              ] &&
                                              request.resource.data
                                                .diff(resource.data)
                                                .affectedKeys()
                                                .hasOnly([
                                                  'status',
                                                  'resolvedAt'
                                                ]);

                                            allow delete: if isParentForChild(childId);
                                          }
                      match /appAccessRequests/{requestId} {
                        allow read: if canReadChild(childId);

                        allow create: if isChildIdentity(childId) &&
                          request.resource.data.requestId == requestId &&
                          request.resource.data.childId == childId &&
                          request.resource.data.familyId ==
                            get(
                              /databases/$(database)/documents/children/$(childId)
                            ).data.familyId &&
                          request.resource.data.packageName is string &&
                          request.resource.data.packageName.size() > 0 &&
                          request.resource.data.packageName.size() <= 255 &&
                          request.resource.data.appName is string &&
                          request.resource.data.appName.size() <= 200 &&
                          request.resource.data.reason is string &&
                          request.resource.data.reason.size() <= 80 &&
                          request.resource.data.status == 'PENDING';

                        allow update: if isParentForChild(childId) &&
                          resource.data.status == 'PENDING' &&
                          request.resource.data.status in [
                            'APPROVED',
                            'DENIED'
                          ] &&
                          request.resource.data.reviewedBy ==
                            request.auth.uid &&
                          request.resource.data
                            .diff(resource.data)
                            .affectedKeys()
                            .hasOnly([
                              'status',
                              'grantedMinutes',
                              'accessUntil',
                              'reviewedBy',
                              'reviewedAt'
                            ]) &&
                          (
                            request.resource.data.status == 'DENIED' ||
                            (
                              request.resource.data.grantedMinutes is int &&
                              request.resource.data.grantedMinutes >= 1 &&
                              request.resource.data.grantedMinutes <= 1440
                            )
                          );

                        allow delete: if isParentForChild(childId);
                      }

                      match /remoteControlOverrides/{eventId} {
                        allow read: if canReadChild(childId);

                        allow create: if isChildIdentity(childId);

                        allow update, delete: if isParentForChild(childId);
                      }

                      match /analytics/{analyticsId} {
                        allow read: if canReadChild(childId);

                        // Generated only by trusted Admin Cloud Functions.
                        allow write: if false;
                      }
                }
                    match /notifications/{notificationId} {
                      allow read: if isEmailVerified() &&
                        resource.data.userId == request.auth.uid;

                      allow create, delete: if false;

                      allow update: if isEmailVerified() &&
                        resource.data.userId == request.auth.uid &&
                        request.resource.data.userId ==
                          resource.data.userId &&
                        request.resource.data
                          .diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['read']) &&
                        request.resource.data.read == true;
                    }
                        match /auditLogs/{auditId} {
                          allow create: if isEmailVerified() &&
                            request.resource.data.actorUid ==
                              request.auth.uid &&
                            request.resource.data.familyId is string &&
                            isFamilyMember(
                              request.resource.data.familyId
                            );

                          allow read: if isPlatformAdmin() ||
                            (
                              isEmailVerified() &&
                              resource.data.familyId is string &&
                              isFamilyMember(resource.data.familyId)
                            );

                          allow update, delete: if false;
                        }
                            match /users/{userId} {
                              allow read, write: if isSignedIn() &&
                                request.auth.uid == userId;

                              match /{document=**} {
                                allow read, write: if isSignedIn() &&
                                  request.auth.uid == userId;
                              }
                            }
                                match /appReleases/{releaseId} {
                                  // Required by the public download/update page.
                                  allow read: if true;

                                  // Releases are published only by trusted Admin tools.
                                  allow create, update, delete:
                                      if isPlatformAdmin();
                                }

                                match /appConfig/{configId} {
                                  // Android/Web clients need the active update configuration.
                                  allow read: if true;

                                  // Only active internal admins may change release configuration.
                                  allow create, update, delete:
                                    if isPlatformAdmin();
                                }

                                    match /familyInvitations/{inviteId} {
                                      allow create: if isEmailVerified() &&
                                        request.resource.data.familyId is string &&
                                        isFamilyOwner(
                                          request.resource.data.familyId
                                        ) &&
                                        request.resource.data.invitedBy ==
                                          request.auth.uid &&
                                        request.resource.data.status == 'PENDING' &&
                                        request.resource.data.email is string &&
                                        request.resource.data.expiresAt >
                                          request.time &&
                                        request.resource.data.role in [
                                          'MANAGER',
                                          'PARENT',
                                          'GUARDIAN',
                                          'VIEWER'
                                        ];

                                      allow read: if isEmailVerified() &&
                                        (
                                          isFamilyOwner(resource.data.familyId) ||
                                          (
                                            request.auth.token.email is string &&
                                            request.auth.token.email.lower() ==
                                              resource.data.email.lower()
                                          )
                                        );

                                      // The owner may revoke a pending invitation only.
                                      // Acceptance and membership changes are handled by
                                      // the trusted Admin Cloud Function.
                                      allow update: if isFamilyOwner(
                                          resource.data.familyId
                                        ) &&
                                        resource.data.status == 'PENDING' &&
                                        request.resource.data.status == 'REVOKED' &&
                                        request.resource.data
                                          .diff(resource.data)
                                          .affectedKeys()
                                          .hasOnly(['status']);

                                      allow delete: if false;
                                    }

                                        match /supportTickets/{ticketId} {
                                          function isSupportAdmin() {
                                            return isSupportStaff() || isAdmin();
                                          }

                                          function isValidStaffAction() {
                                            return request.resource.data.lastAdminAction is map &&
                                              request.resource.data.lastAdminAction.actorUid ==
                                                request.auth.uid &&
                                              request.resource.data.lastAdminAction.actorEmail is string &&
                                              request.resource.data.lastAdminAction.actorEmail.lower() ==
                                                request.auth.token.email.lower() &&
                                              request.resource.data.lastAdminAction.type in [
                                                'REPLY',
                                                'STATUS_CHANGE'
                                              ] &&
                                              request.resource.data.lastAdminAction.occurredAt is timestamp;
                                          }

                                          function isValidStaffReply() {
                                            let oldReplies = resource.data.replies;
                                            let newReplies = request.resource.data.replies;
                                            let reply = newReplies[oldReplies.size()];

                                            return oldReplies is list &&
                                              newReplies is list &&
                                              newReplies.size() == oldReplies.size() + 1 &&
                                              newReplies == oldReplies.concat([reply]) &&
                                              reply is map &&
                                              reply.keys().hasOnly([
                                                'replyId',
                                                'authorUid',
                                                'authorEmail',
                                                'authorRole',
                                                'message',
                                                'createdAt'
                                              ]) &&
                                              reply.replyId is string &&
                                              reply.replyId.size() >= 8 &&
                                              reply.replyId.size() <= 80 &&
                                              reply.authorUid == request.auth.uid &&
                                              reply.authorEmail is string &&
                                              reply.authorEmail.lower() ==
                                                request.auth.token.email.lower() &&
                                              reply.authorRole == 'ADMIN' &&
                                              reply.message is string &&
                                              reply.message.size() > 0 &&
                                              reply.message.size() <= 4000 &&
                                              reply.createdAt is timestamp &&
                                              request.resource.data.status == 'IN_PROGRESS' &&
                                              request.resource.data
                                                .diff(resource.data)
                                                .affectedKeys()
                                                .hasOnly([
                                                  'replies',
                                                  'updatedAt',
                                                  'status',
                                                  'lastAdminAction'
                                                ]);
                                          }

                                          function isValidStaffStatusChange() {
                                            return request.resource.data.replies ==
                                                resource.data.replies &&
                                              request.resource.data.status in [
                                                'OPEN',
                                                'IN_PROGRESS',
                                                'RESOLVED',
                                                'CLOSED'
                                              ] &&
                                              request.resource.data
                                                .diff(resource.data)
                                                .affectedKeys()
                                                .hasOnly([
                                                  'updatedAt',
                                                  'status',
                                                  'lastAdminAction'
                                                ]);
                                          }

                                          function isValidEmployeeSupportUpdate() {
                                            return isEmployeeStaff() &&
                                              request.resource.data.updatedAt == request.time &&
                                              isValidStaffAction() &&
                                              (
                                                isValidStaffReply() ||
                                                isValidStaffStatusChange()
                                              );
                                          }

                                          function isValidParentReply() {
                                            let oldReplies = resource.data.replies;
                                            let newReplies = request.resource.data.replies;
                                            let reply = newReplies[oldReplies.size()];

                                            return oldReplies is list &&
                                              newReplies is list &&
                                              newReplies.size() == oldReplies.size() + 1 &&
                                              newReplies == oldReplies.concat([reply]) &&
                                              reply is map &&
                                              reply.keys().hasOnly([
                                                'replyId',
                                                'authorUid',
                                                'authorEmail',
                                                'authorRole',
                                                'message',
                                                'createdAt'
                                              ]) &&
                                              reply.replyId is string &&
                                              reply.replyId.size() >= 8 &&
                                              reply.replyId.size() <= 80 &&
                                              reply.authorUid == request.auth.uid &&
                                              reply.authorEmail is string &&
                                              reply.authorEmail.lower() ==
                                                request.auth.token.email.lower() &&
                                              reply.authorRole == 'PARENT' &&
                                              reply.message is string &&
                                              reply.message.size() > 0 &&
                                              reply.message.size() <= 4000 &&
                                              reply.createdAt is timestamp;
                                          }

                                          allow create: if isEmailVerified() &&
                                            request.resource.data.parentUid ==
                                              request.auth.uid &&
                                            request.resource.data.ticketId == ticketId &&
                                            request.resource.data.status == 'OPEN' &&
                                            request.resource.data.replies is list &&
                                            request.resource.data.replies.size() == 0;

                                          allow read: if isEmailVerified() &&
                                            (
                                              resource.data.parentUid ==
                                                request.auth.uid ||
                                              isSupportAdmin()
                                            );

                                          allow update: if isPlatformAdmin() ||
                                            isAdmin() ||
                                            isValidEmployeeSupportUpdate() ||
                                            (
                                              isEmailVerified() &&
                                              resource.data.parentUid ==
                                                request.auth.uid &&
                                              request.resource.data.parentUid ==
                                                resource.data.parentUid &&
                                              request.resource.data.ticketId ==
                                                resource.data.ticketId &&
                                              request.resource.data
                                                .diff(resource.data)
                                                .affectedKeys()
                                                .hasOnly([
                                                  'replies',
                                                  'updatedAt',
                                                  'status'
                                                ]) &&
                                              request.resource.data.status ==
                                                'OPEN' &&
                                              request.resource.data.updatedAt ==
                                                request.time &&
                                              isValidParentReply()
                                            );

                                          allow delete: if isPlatformAdmin() || isAdmin();
                                        }
                                
    // Enables the internal issues collection-group query without granting
    // parent/child access to technical stack traces.
    match /{path=**}/errorReports/{errorId} {
      allow read: if isSupportStaff();
    }

    // Rules will be added collection by collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
