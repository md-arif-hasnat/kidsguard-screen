rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
        function isEmailVerified() {
          return isSignedIn() &&
            request.auth.token.email_verified == true;
        }

            function isAdmin() {
              return isEmailVerified() &&
                get(
                  /databases/$(database)/documents/parents/$(request.auth.uid)
                ).data.role == 'ADMIN';
            }


        function familyData(familyId) {
          return get(
            /databases/$(database)/documents/families/$(familyId)
          ).data;
        }

        function isFamilyOwner(familyId) {
          return isSignedIn() &&
            familyData(familyId).ownerId == request.auth.uid;
        }
            function isDeviceOwner(deviceId) {
              return isSignedIn() &&
                get(
                  /databases/$(database)/documents/devices/$(deviceId)
                ).data.firebaseUid == request.auth.uid;
            }

            function isChildIdentity(childId) {
              return isSignedIn() &&
                get(
                  /databases/$(database)/documents/children/$(childId)
                ).data.firebaseUid == request.auth.uid;
            }

            function canReadChild(childId) {
              let child = get(
                /databases/$(database)/documents/children/$(childId)
              ).data;

              return isSignedIn() &&
                (
                  child.firebaseUid == request.auth.uid ||
                  isFamilyMember(child.familyId)
                );
            }
                function isParentForChild(childId) {
                  let child = get(
                    /databases/$(database)/documents/children/$(childId)
                  ).data;

                        return isEmailVerified() &&
                          isFamilyManager(child.familyId);
                }

        function isFamilyMember(familyId) {
          let family = familyData(familyId);

          return isSignedIn() &&
            (
              family.ownerId == request.auth.uid ||
              (
                family.keys().hasAny(['memberUids']) &&
                family.memberUids is list &&
                request.auth.uid in family.memberUids
              )
            );
        }
            function isFamilyManager(familyId) {
              let family = familyData(familyId);

              return isEmailVerified() &&
                (
                  family.ownerId == request.auth.uid ||
                  (
                    family.keys().hasAny(['managerUids']) &&
                    family.managerUids is list &&
                    request.auth.uid in family.managerUids
                  )
                );
            }
    match /parents/{parentId} {
      allow read: if isEmailVerified() &&
        request.auth.uid == parentId;

            allow create: if isSignedIn() &&
              request.auth.uid == parentId &&
              request.resource.data.uid == request.auth.uid &&
              (
                isEmailVerified() ||
                request.resource.data.keys().hasAll([
                  'legalConsentAcceptedAt',
                  'termsVersion',
                  'privacyVersion',
                  'adultConfirmedAt'
                ])
              ) &&
              (
                !request.resource.data.keys().hasAny(['role']) ||
                request.resource.data.role in [
                  'OWNER',
                  'PARENT',
                  'GUARDIAN',
                  'VIEWER'
                ]
              );

            allow update: if isEmailVerified() &&
              request.auth.uid == parentId &&
              !request.resource.data
                .diff(resource.data)
                .affectedKeys()
                .hasAny([
                  'uid',
                  'role',
                  'subscriptionStatus',
                  'trialStartedAt',
                  'trialEndsAt',
                  'planId',
                  'basePriceCents',
                  'includedChildren',
                  'extraChildPriceCents',
                  'currency'
                ]);

            allow delete: if isEmailVerified() &&
              request.auth.uid == parentId;

      match /{subcollection}/{documentId}/{nested=**} {
        allow read, write: if isEmailVerified() &&
          request.auth.uid == parentId;
      }
    }

    match /billingConfig/{configId} {
      allow read: if isEmailVerified();
      allow create, update, delete: if isAdmin();
    }

        match /families/{familyId} {
          allow read: if isFamilyMember(familyId);

          allow create: if isEmailVerified() &&
            request.resource.data.ownerId == request.auth.uid &&
            request.resource.data.memberUids == [request.auth.uid] &&
            request.resource.data.managerUids == [request.auth.uid] &&
            request.resource.data.childDeviceIds is list &&
            request.resource.data.childDeviceIds.size() == 0 &&
            request.resource.data.subscription.baseChildSlots == 2 &&
            request.resource.data.subscription.extraChildSlots == 0 &&
            request.resource.data.subscription.status == 'PENDING';

                allow update: if isFamilyOwner(familyId) &&
                  request.resource.data.ownerId ==
                    resource.data.ownerId &&
                  !request.resource.data
                    .diff(resource.data)
                    .affectedKeys()
                    .hasAny([
                      'ownerId',
                      'childDeviceIds',
                      'subscription',
                      'deletionStatus',
                      'deletionRequestedAt',
                      'deletionScheduledAt',
                      'deletionRequestedBy'
                    ]);
          allow delete: if false;
                match /safeZones/{zoneId} {
                  allow read: if isFamilyMember(familyId);
                  allow write: if isFamilyOwner(familyId);
                }
        }
            match /devices/{deviceId} {
              allow create: if isSignedIn() &&
                request.resource.data.firebaseUid == request.auth.uid &&
                request.resource.data.deviceId == deviceId;

                    allow read, delete: if isDeviceOwner(deviceId);

                    allow update: if isDeviceOwner(deviceId) &&
                      request.resource.data.firebaseUid ==
                        resource.data.firebaseUid &&
                      request.resource.data.deviceId ==
                        resource.data.deviceId;
            }

            match /pairingCodes/{code} {
              allow create: if isSignedIn() &&
                code.matches('^[0-9]{6}$') &&
                request.resource.data.code == code &&
                request.resource.data.firebaseUid == request.auth.uid &&
                request.resource.data.childId is string &&
                request.resource.data.deviceId is string &&
                isDeviceOwner(request.resource.data.deviceId) &&
                request.resource.data.used == false &&
                request.resource.data.expiresAt > request.time;

              allow read, delete: if isSignedIn() &&
                resource.data.firebaseUid == request.auth.uid;

              // Only Admin Cloud Functions can update/consume a code.
              allow update: if false;
            }

                match /children/{childId} {
                  allow read: if canReadChild(childId);

                  // Root child records are managed by Admin Cloud Functions.
                  allow create, update, delete: if false;

                  match /status/{statusId} {
                    allow read: if canReadChild(childId);

                            allow create: if isSignedIn() &&
                              request.resource.data.childId == childId &&
                              request.resource.data.deviceId is string &&
                              isDeviceOwner(request.resource.data.deviceId);

                            allow update: if isSignedIn() &&
                              resource.data.childId == childId &&
                              request.resource.data.childId ==
                                resource.data.childId &&
                              request.resource.data.deviceId ==
                                resource.data.deviceId &&
                              isDeviceOwner(resource.data.deviceId);

                    allow delete: if false;
                  }
                        match /safeZones/{zoneId} {
                          allow read: if canReadChild(childId);
                          allow write: if isParentForChild(childId);
                        }

                        match /locations/{locationId} {
                          allow read: if canReadChild(childId);

                          allow create: if isChildIdentity(childId);

                          allow update, delete: if false;
                        }

                        match /activities/{activityId} {
                          allow read: if canReadChild(childId);

                          allow create: if isChildIdentity(childId);

                          allow update, delete: if false;

                        }
                              match /sosEvents/{eventId} {
                                allow read: if canReadChild(childId);

                                allow create: if isChildIdentity(childId);

                                allow update: if isChildIdentity(childId) ||
                                  isParentForChild(childId);

                                allow delete: if false;
                              }
                                    match /dailySummaries/{summaryId} {
                                      allow read: if canReadChild(childId);

                                      // Generated only by trusted Admin Cloud Functions.
                                      allow write: if false;
                                    }

                                    match /routeDeviations/{deviationId} {
                                      allow read: if canReadChild(childId);

                                      allow create: if isChildIdentity(childId);

                                      allow update: if isChildIdentity(childId) ||
                                        isParentForChild(childId);

                                      allow delete: if false;
                                    }
                              match /remoteCommands/{commandId} {
                                allow read: if canReadChild(childId);

                                allow create, delete: if isParentForChild(childId);

                                allow update: if isParentForChild(childId) ||
                                  isChildIdentity(childId);
                              }
                                    match /installedApps/{appId} {
                                      allow read: if canReadChild(childId);
                                      allow write: if isChildIdentity(childId);
                                    }

                                    match /appUsage/{document=**} {
                                      allow read: if canReadChild(childId);
                                      allow write: if isChildIdentity(childId);
                                    }

                                    match /youtubeHistory/{historyId} {
                                      allow read: if canReadChild(childId);
                                      allow write: if isChildIdentity(childId);
                                    }

                                    match /webActivity/{document=**} {
                                      allow read: if canReadChild(childId);
                                      allow write: if isChildIdentity(childId);
                                    }
                                          match /appControls/{controlId} {
                                            allow read: if canReadChild(childId);
                                            allow write: if isParentForChild(childId);
                                          }

                                          match /settings/{settingId} {
                                            allow read: if canReadChild(childId);
                                            allow write: if isParentForChild(childId);
                                          }

                                          match /webRules/{ruleId} {
                                            allow read: if canReadChild(childId);
                                            allow write: if isParentForChild(childId);
                                          }

                                          match /protectionModes/{modeId} {
                                            allow read: if canReadChild(childId);

                                            allow write: if isParentForChild(childId) ||
                                              isChildIdentity(childId);
                                          }

                                          match /accessRequests/{requestId} {
                                            allow read: if canReadChild(childId);

                                            allow create: if isChildIdentity(childId);

                                            allow update: if isParentForChild(childId) ||
                                              isChildIdentity(childId);

                                            allow delete: if isParentForChild(childId);
                                          }
                      match /appAccessRequests/{requestId} {
                        allow read: if canReadChild(childId);

                        allow create: if isChildIdentity(childId);

                        allow update: if isParentForChild(childId) ||
                          isChildIdentity(childId);

                        allow delete: if isParentForChild(childId);
                      }

                      match /analytics/{analyticsId} {
                        allow read: if canReadChild(childId);

                        // Generated only by trusted Admin Cloud Functions.
                        allow write: if false;
                      }
                }
                    match /notifications/{notificationId} {
                      allow read: if isEmailVerified() &&
                        resource.data.userId == request.auth.uid;

                      allow create, delete: if false;

                      allow update: if isEmailVerified() &&
                        resource.data.userId == request.auth.uid &&
                        request.resource.data.userId ==
                          resource.data.userId &&
                        request.resource.data
                          .diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['read']) &&
                        request.resource.data.read == true;
                    }
                        match /auditLogs/{auditId} {
                          allow create: if isEmailVerified() &&
                            request.resource.data.actorUid ==
                              request.auth.uid &&
                            request.resource.data.familyId is string &&
                            isFamilyMember(
                              request.resource.data.familyId
                            );

                          allow read: if isEmailVerified() &&
                            resource.data.familyId is string &&
                            isFamilyMember(resource.data.familyId);

                          allow update, delete: if false;
                        }
                            match /users/{userId} {
                              allow read, write: if isSignedIn() &&
                                request.auth.uid == userId;

                              match /{document=**} {
                                allow read, write: if isSignedIn() &&
                                  request.auth.uid == userId;
                              }
                            }
                                match /appReleases/{releaseId} {
                                  // Required by the public download/update page.
                                  allow read: if true;

                                  // Releases are published only by trusted Admin tools.
                                  allow write: if false;
                                }

                                    match /familyInvitations/{inviteId} {
                                      allow create: if isEmailVerified() &&
                                        request.resource.data.familyId is string &&
                                        isFamilyOwner(
                                          request.resource.data.familyId
                                        ) &&
                                        request.resource.data.invitedBy ==
                                          request.auth.uid &&
                                        request.resource.data.status == 'PENDING' &&
                                        request.resource.data.email is string &&
                                        request.resource.data.expiresAt >
                                          request.time &&
                                        request.resource.data.role in [
                                          'PARENT',
                                          'GUARDIAN',
                                          'VIEWER'
                                        ];

                                      allow read: if isEmailVerified() &&
                                        (
                                          isFamilyOwner(resource.data.familyId) ||
                                          (
                                            request.auth.token.email is string &&
                                            request.auth.token.email.lower() ==
                                              resource.data.email.lower()
                                          )
                                        );

                                      // Family Owner may revoke/update an invitation.
                                      // Acceptance is handled only by Admin Cloud Function.
                                      allow update: if isFamilyOwner(
                                        resource.data.familyId
                                      );

                                      allow delete: if false;
                                    }

                                        match /supportTickets/{ticketId} {
                                          allow create: if isEmailVerified() &&
                                            request.resource.data.parentUid ==
                                              request.auth.uid &&
                                            request.resource.data.ticketId == ticketId &&
                                            request.resource.data.status == 'OPEN' &&
                                            request.resource.data.replies is list &&
                                            request.resource.data.replies.size() == 0;

                                          allow read: if isEmailVerified() &&
                                            (
                                              resource.data.parentUid ==
                                                request.auth.uid ||
                                              isAdmin()
                                            );

                                          allow update: if isAdmin() ||
                                            (
                                              isEmailVerified() &&
                                              resource.data.parentUid ==
                                                request.auth.uid &&
                                              request.resource.data.parentUid ==
                                                resource.data.parentUid &&
                                              request.resource.data.ticketId ==
                                                resource.data.ticketId &&
                                              request.resource.data
                                                .diff(resource.data)
                                                .affectedKeys()
                                                .hasOnly([
                                                  'replies',
                                                  'updatedAt',
                                                  'status'
                                                ])
                                            );

                                          allow delete: if isAdmin();
                                        }
                                
    // Rules will be added collection by collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
